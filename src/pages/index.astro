---
import Base from '../layouts/Base.astro';
---
<Base>
  <div id="stage">
    <canvas id="map" aria-hidden="true"></canvas>
    <div id="labels" aria-hidden="true"></div>
  </div>

  <p class="sr-only">
    Meaning Map is an interactive atlas of 893 US occupations, arranged by an AI reading of
    what each job actually involves, clustering related work into regions and coloured by
    occupation family. To explore without the map, use the search box to find an occupation;
    selecting one lists the jobs most similar to it, ranked by similarity.
  </p>

  <header id="head">
    <h1><span class="dot"></span>Meaning&nbsp;Map</h1>
    <div class="clamp-wrap">
      <p><b>What is this site and what does it do?</b> An experiment in how AI reads meaning: a small
         language model read 893 real job descriptions and scored how alike any two are. That score
         became this map — related work clusters into regions, each match ranked by percentage.
         Click any point to find jobs like it.</p>
      <button class="more" type="button" aria-expanded="false" hidden>More</button>
    </div>
  </header>

  <!-- dustincoledata brand mark -->
  <a class="dcd-mark" href="https://dustincoledata.com" target="_blank" rel="noopener"
     aria-label="A Dustin Cole Data project">
    <svg class="dcd-mark-logo" viewBox="3.8 17.1 56.5 29.8" aria-hidden="true" focusable="false">
      <g transform="translate(2.943 46.426) scale(0.040753 -0.040753)">
        <path fill="currentColor" d="M22 269Q22 388 88.5 468.0Q155 548 262 548Q345 548 408 488V718H579V0H422V61Q354 -10 262 -10Q155 -10 88.5 70.5Q22 151 22 269ZM200 269Q200 209 230.5 176.5Q261 144 303 144Q346 144 376.0 177.0Q406 210 406 270Q406 331 376.0 362.5Q346 394 303.0 394.0Q260 394 230.0 362.0Q200 330 200 269Z"/>
        <path fill="currentColor" transform="translate(605 0)" d="M293 -10Q173 -10 97.5 68.0Q22 146 22 269Q22 389 99.5 468.5Q177 548 293 548Q404 548 479.5 479.0Q555 410 566 298H384Q382 342 357.5 368.0Q333 394 294 394Q249 394 224.0 361.0Q199 328 199 269Q199 208 223.5 175.5Q248 143 294 143Q334 143 357.5 168.5Q381 194 384 240H566Q555 125 481.5 57.5Q408 -10 293 -10Z"/>
        <path class="dcd-mark-dot" transform="translate(1163 0)" d="M241 104Q241 56 211.0 25.5Q181 -5 133.0 -5.0Q85 -5 54.5 25.5Q24 56 24 104Q24 153 54.5 183.5Q85 214 133.0 214.0Q181 214 211.0 183.5Q241 153 241 104Z"/>
      </g>
    </svg>
    <i class="dcd-mark-rule" aria-hidden="true"></i>
    <span class="dcd-mark-words"><span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span></span>
  </a>

  <div id="search" role="search">
    <div class="box">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="q" type="text" placeholder="Find an occupation…" autocomplete="off" spellcheck="false" aria-label="Find an occupation" />
    </div>
    <div id="results" role="listbox" aria-label="Search results"></div>
  </div>

  <div id="legend">
    <div class="lg-title">Occupation families</div>
    <div class="lg-note">Scattered — no home region</div>
  </div>

  <div id="foot">
    <!-- The key names what the map ENCODES. It used to read "near = similar work" — a distance
         claim the projection cannot support: the nearest dot on screen is the #1 match just 31%
         of the time (mean rank correlation 0.43). The ranking is carried by the leader lines
         instead, so the key states that, and claims nothing about distance. "better" not
         "closer": the point is to get spatial language out of the sentence entirely.
         Two keys, not three, is a width constraint — a third fits at 1440 but pushes the source
         block to three lines below ~940px, and the footer is not allowed to move. -->
    <div id="helper">
      <span class="k">
        <svg class="fan" width="30" height="14" viewBox="0 0 30 14" fill="none" aria-hidden="true">
          <circle cx="3" cy="7" r="2.1" opacity=".55"/>
          <path d="M4 7h25" stroke-width="2.4" opacity=".42"/>
          <path d="M4.4 6.2 28 1.6" stroke-width="1.6" opacity=".26"/>
          <path d="M4.4 7.8 28 12.4" stroke-width="0.8" opacity=".13"/>
        </svg>
        <b>heavier = better match</b>
      </span>
      <span class="k">colour = family</span>
    </div>
    <div id="source">
      <b>Occupation data:</b> O*NET&nbsp;30.3 (US&nbsp;DOL/ETA, CC&nbsp;BY&nbsp;4.0) · <b>Wage&nbsp;&amp;&nbsp;employment:</b> BLS&nbsp;OEWS<br>
      893 occupations · text embeddings <b>bge-small-en-v1.5</b> · 2-D projection via <b>UMAP</b>
    </div>
  </div>

  <div id="tip" role="status" aria-live="polite"></div>

  <aside id="panel" aria-label="Occupation detail">
    <button class="close" aria-label="Close detail panel">✕</button>
    <!-- phone only: fold the identity card away so the ranked list gets the sheet -->
    <button class="fold" type="button" aria-expanded="true" aria-label="Collapse job details">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
    </button>
    <span class="fam-tag"><i></i><span class="ft-name"></span></span>
    <h2></h2>
    <div class="code"></div>
    <div class="meta"></div>
    <div class="clamp-wrap">
      <div class="desc"></div>
      <button class="more" type="button" aria-expanded="false" hidden>More</button>
    </div>
    <div class="nb-h"><b>Jobs like this</b><span>nearest by what the work involves</span></div>
    <div id="nbs"></div>
  </aside>

  <script>
    import '../scripts/map.ts';
  </script>
</Base>
